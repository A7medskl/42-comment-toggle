{
	"name": "42-comment-toggle",
	"displayName": "42-comment toggle",
	"description": "42-style block comments: comment and uncomment with one key (fork of nasanov/42-comment)",
	"icon": "images/42-comment-logo.png",
	"version": "0.1.0",
	"publisher": "asakli",
	"engines": {
		"vscode": "^1.38.1"
	},
	"categories": [
		"Formatters"
	],
	"activationEvents": [
		"onCommand:extension.42-comment-toggle"
	],
	"main": "src/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "extension.42-comment-toggle",
				"title": "42-comment toggle"
			}
		],
		"keybindings": [
			{
				"command": "extension.42-comment-toggle",
				"key": "ctrl+alt+*",
				"mac": "shift+cmd+*",
				"when": "editorTextFocus && !editorReadonly"
			}
		]
	},
	"scripts": {
		"test": "node test/42-comment.test.js"
	},
	"dependencies": {}
}
